from pathlib import Path

from harbor.constants import (
    PACKAGE_CACHE_DIR as PACKAGE_CACHE_DIR,
    TASK_CACHE_DIR as TASK_CACHE_DIR,
)
from pydantic import BaseModel

def normalize_git_task_path(path: Path) -> Path: ...

class GitTaskId(BaseModel):
    ...
    git_url: str
    git_commit_id: str | None = ...
    path: Path
    @classmethod
    def normalize_path(cls, path: Path) -> Path: ...
    def get_name(self) -> str: ...
    def get_local_path(self) -> Path: ...

class LocalTaskId(BaseModel):
    ...
    path: Path
    def get_name(self) -> str: ...
    def get_local_path(self) -> Path: ...

class PackageTaskId(BaseModel):
    ...
    org: str
    name: str
    ref: str | None = ...
    def get_name(self) -> str: ...
    def get_local_path(self) -> Path: ...
