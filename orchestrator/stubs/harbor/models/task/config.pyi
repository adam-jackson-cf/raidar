class MultiStepRewardStrategy(StrEnum):
    MEAN = "mean"
    FINAL = "final"

class TaskConfig(BaseModel):
    schema_version: str = ...
    task: PackageInfo | None = ...
    metadata: dict[str, Any] = ...
    verifier: VerifierConfig = ...
    agent: AgentConfig = ...
    environment: EnvironmentConfig = ...
    solution: SolutionConfig = ...
    source: str | None = ...
    multi_step_reward_strategy: MultiStepRewardStrategy | None = ...
    steps: list[StepConfig] | None = ...
    artifacts: list[str | ArtifactConfig] = ...
