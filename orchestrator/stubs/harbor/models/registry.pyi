from pathlib import Path

from harbor.models.metric.config import MetricConfig as MetricConfig
from harbor.models.task.id import (
    GitTaskId as GitTaskId,
    LocalTaskId as LocalTaskId,
    PackageTaskId as PackageTaskId,
)
from pydantic import BaseModel

class DatasetSummary(BaseModel):
    name: str
    version: str | None = ...
    description: str = ...
    task_count: int

class DatasetFileInfo(BaseModel):
    path: str
    storage_path: str
    content_hash: str

class DatasetMetadata(BaseModel):
    name: str
    version: str | None = ...
    description: str = ...
    task_ids: list[GitTaskId | LocalTaskId | PackageTaskId]
    metrics: list[MetricConfig] = ...
    files: list[DatasetFileInfo] = ...
    dataset_version_id: str | None = ...
    dataset_version_content_hash: str | None = ...

class LocalRegistryInfo(BaseModel):
    name: str | None = ...
    path: Path

class RemoteRegistryInfo(BaseModel):
    name: str | None = ...
    url: str = ...

class RegistryTaskId(BaseModel):
    name: str
    git_url: str | None = ...
    git_commit_id: str | None = ...
    path: Path
    def to_source_task_id(self) -> GitTaskId | LocalTaskId: ...
    def get_name(self) -> str: ...

class DatasetSpec(BaseModel):
    name: str
    version: str
    description: str
    tasks: list[RegistryTaskId]
    metrics: list[MetricConfig] = ...

class Registry(BaseModel):
    name: str | None = ...
    url: str | None = ...
    path: Path | None = ...
    datasets: list[DatasetSpec]
    def __post_init__(self) -> None: ...
    @classmethod
    def from_url(cls, url: str) -> Registry: ...
    @classmethod
    def from_path(cls, path: Path) -> Registry: ...
