from datetime import datetime
from uuid import UUID

from harbor.models.agent.context import AgentContext as AgentContext
from harbor.models.task.config import VerifierEnvironmentMode as VerifierEnvironmentMode
from harbor.models.task.id import (
    GitTaskId as GitTaskId,
    LocalTaskId as LocalTaskId,
    PackageTaskId as PackageTaskId,
)
from harbor.models.trial.config import TrialConfig as TrialConfig
from harbor.models.verifier.result import VerifierResult as VerifierResult
from pydantic import BaseModel

class TimingInfo(BaseModel):
    started_at: datetime | None = ...
    finished_at: datetime | None = ...

class ExceptionInfo(BaseModel):
    exception_type: str
    exception_message: str
    exception_traceback: str
    occurred_at: datetime
    @classmethod
    def from_exception(cls, e: BaseException) -> ExceptionInfo: ...

class ModelInfo(BaseModel):
    name: str
    provider: str | None = ...

class AgentInfo(BaseModel):
    name: str
    version: str
    model_info: ModelInfo | None = ...

class StepResult(BaseModel):
    step_name: str
    agent_result: AgentContext | None = ...
    verifier_result: VerifierResult | None = ...
    exception_info: ExceptionInfo | None = ...
    agent_execution: TimingInfo | None = ...
    verifier: TimingInfo | None = ...

class TrialResult(BaseModel):
    id: UUID = ...
    task_name: str
    trial_name: str
    trial_uri: str
    task_id: LocalTaskId | GitTaskId | PackageTaskId
    source: str | None = ...
    task_checksum: str
    config: TrialConfig
    agent_info: AgentInfo
    agent_result: AgentContext | None = ...
    verifier_result: VerifierResult | None = ...
    verifier_environment_mode: VerifierEnvironmentMode | None = ...
    exception_info: ExceptionInfo | None = ...
    started_at: datetime | None = ...
    finished_at: datetime | None = ...
    environment_setup: TimingInfo | None = ...
    agent_setup: TimingInfo | None = ...
    agent_execution: TimingInfo | None = ...
    verifier: TimingInfo | None = ...
    step_results: list[StepResult] | None = ...
    def compute_token_cost_totals(
        self,
    ) -> tuple[int | None, int | None, int | None, float | None]: ...
