from enum import StrEnum
from pathlib import Path
from typing import Any, Literal, NotRequired, TypedDict
from uuid import UUID

from harbor.models.agent.name import AgentName as AgentName
from harbor.models.bridge import BridgeConfig as BridgeConfig
from harbor.models.environment_type import EnvironmentType as EnvironmentType
from harbor.models.task.config import (
    ArtifactConfig as ArtifactConfig,
    MCPServerConfig as MCPServerConfig,
    TpuSpec as TpuSpec,
    normalize_allowed_hosts as normalize_allowed_hosts,
)
from harbor.models.task.id import (
    GitTaskId as GitTaskId,
    LocalTaskId as LocalTaskId,
    PackageTaskId as PackageTaskId,
)
from harbor.utils.env import templatize_sensitive_env as templatize_sensitive_env
from pydantic import BaseModel, SerializationInfo as SerializationInfo

class ServiceVolumeBind(TypedDict):
    create_host_path: NotRequired[Literal[False]]
    selinux: NotRequired[Literal["z", "Z"]]

class ServiceVolumeVolume(TypedDict):
    subpath: NotRequired[str]

class ServiceVolumeImage(TypedDict):
    subpath: NotRequired[str]

class ServiceVolumeConfig(TypedDict):
    type: Literal["bind", "volume", "image"]
    source: str
    target: str
    read_only: NotRequired[Literal[True]]
    bind: NotRequired[ServiceVolumeBind]
    volume: NotRequired[ServiceVolumeVolume]
    image: NotRequired[ServiceVolumeImage]

class ResourceMode(StrEnum):
    AUTO = "auto"
    LIMIT = "limit"
    REQUEST = "request"
    GUARANTEE = "guarantee"
    IGNORE = "ignore"

class AgentConfig(BaseModel):
    name: str | None = ...
    import_path: str | None = ...
    model_name: str | None = ...
    n_concurrent: int | None = ...
    concurrency_group: str | None = ...
    skills: list[str | Path] = ...
    @classmethod
    def _normalize_skills_to_str(cls, v: list[str | Path]) -> list[str]: ...
    override_timeout_sec: float | None = ...
    override_setup_timeout_sec: float | None = ...
    max_timeout_sec: float | None = ...
    resume_trajectory: bool = ...
    load_trajectory: str | None = ...
    extra_allowed_hosts: list[str] = ...
    include_logs: list[str] = ...
    exclude_logs: list[str] = ...
    kwargs: dict[str, Any] = ...
    env: dict[str, str] = ...
    mcp_servers: list[MCPServerConfig] = ...
    @classmethod
    def validate_extra_allowed_hosts(cls, hosts: list[str]) -> list[str]: ...
    @classmethod
    def _serialize_env(cls, env: dict[str, str], info: SerializationInfo) -> dict[str, str]: ...
    @property
    def concurrency_key(self) -> str: ...

class UserAgentConfig(AgentConfig):
    user_persona_path: Path | None = ...
    user_prompt_template_path: Path | None = ...
    bridge: BridgeConfig

class EnvironmentConfig(BaseModel):
    type: EnvironmentType | None = ...
    import_path: str | None = ...
    force_build: bool = ...
    delete: bool = ...
    cpu_enforcement_policy: ResourceMode = ...
    memory_enforcement_policy: ResourceMode = ...
    override_cpus: int | None = ...
    override_memory_mb: int | None = ...
    override_storage_mb: int | None = ...
    override_gpus: int | None = ...
    override_tpu: TpuSpec | None = ...
    suppress_override_warnings: bool = ...
    mounts: list[ServiceVolumeConfig] | None = ...
    extra_docker_compose: list[Path] = ...
    env: dict[str, str] = ...
    kwargs: dict[str, Any] = ...
    extra_allowed_hosts: list[str] = ...
    @classmethod
    def validate_extra_allowed_hosts(cls, hosts: list[str]) -> list[str]: ...
    @classmethod
    def _accept_legacy_mounts_json(cls, data: Any) -> Any: ...
    @classmethod
    def _normalize_resource_mode(cls, value: Any) -> Any: ...
    @property
    def mounts_json(self) -> list[ServiceVolumeConfig] | None: ...
    @mounts_json.setter
    def mounts_json(self, value: list[ServiceVolumeConfig] | None) -> None: ...
    @classmethod
    def _serialize_env(cls, env: dict[str, str]) -> dict[str, str]: ...
    @classmethod
    def _env_list_to_dict(cls, v: list[str] | dict[str, str]) -> dict[str, str]: ...

class VerifierConfig(BaseModel):
    override_timeout_sec: float | None = ...
    max_timeout_sec: float | None = ...
    include_logs: list[str] = ...
    exclude_logs: list[str] = ...
    env: dict[str, str] = ...
    import_path: str | None = ...
    kwargs: dict[str, Any] = ...
    disable: bool = ...
    @classmethod
    def _serialize_env(cls, env: dict[str, str]) -> dict[str, str]: ...

class TaskConfig(BaseModel):
    path: Path | None = ...
    git_url: str | None = ...
    git_commit_id: str | None = ...
    name: str | None = ...
    ref: str | None = ...
    overwrite: bool = ...
    download_dir: Path | None = ...
    source: str | None = ...
    def is_git_task(self) -> bool: ...
    def is_package_task(self) -> bool: ...
    def get_task_id(self) -> LocalTaskId | GitTaskId | PackageTaskId: ...
    def get_local_path(self) -> Path: ...

class SourceTrialConfig(BaseModel):
    action: Literal["regrade"]
    type: Literal["local", "hub"]
    trial_id: UUID | None = ...
    path: Path | None = ...

class TrialConfig(BaseModel):
    task: TaskConfig
    trial_name: str = ...
    trials_dir: Path = ...
    install_only: bool = ...
    timeout_multiplier: float = ...
    agent_timeout_multiplier: float | None = ...
    verifier_timeout_multiplier: float | None = ...
    agent_setup_timeout_multiplier: float | None = ...
    environment_build_timeout_multiplier: float | None = ...
    agent: AgentConfig = ...
    user_agent: UserAgentConfig | None = ...
    environment: EnvironmentConfig = ...
    verifier: VerifierConfig = ...
    artifacts: list[str | ArtifactConfig] = ...
    extra_instruction_paths: list[Path] = ...
    extra_instructions: list[str] = ...
    job_id: UUID | None = ...
    source_trial: SourceTrialConfig | None = ...
    @property
    def is_regrade(self) -> bool: ...
    def __eq__(self, other: object) -> bool: ...
    def generate_trial_name(self) -> str: ...
