from pathlib import Path
from typing import Any, Literal
from uuid import UUID

from harbor.models.metric.config import MetricConfig as MetricConfig
from harbor.models.task.id import (
    GitTaskId as GitTaskId,
    LocalTaskId as LocalTaskId,
    PackageTaskId as PackageTaskId,
)
from harbor.models.trial.config import (
    AgentConfig as AgentConfig,
    ArtifactConfig as ArtifactConfig,
    EnvironmentConfig as EnvironmentConfig,
    TaskConfig as TaskConfig,
    UserAgentConfig as UserAgentConfig,
    VerifierConfig as VerifierConfig,
)
from harbor.registry.client.base import EmptyDatasetError as EmptyDatasetError
from pydantic import BaseModel

class DatasetConfig(BaseModel):
    path: Path | None = ...
    name: str | None = ...
    version: str | None = ...
    ref: str | None = ...
    registry_url: str | None = ...
    registry_path: Path | None = ...
    repo: str | None = ...
    overwrite: bool = ...
    download_dir: Path | None = ...
    task_names: list[str] | None = ...
    exclude_task_names: list[str] | None = ...
    n_tasks: int | None = ...
    def is_repo(self) -> bool: ...
    def is_local(self) -> bool: ...
    def is_package(self) -> bool: ...
    def is_registry(self) -> bool: ...
    def _filter_task_ids(
        self, task_ids: list[LocalTaskId | GitTaskId | PackageTaskId]
    ) -> list[LocalTaskId | GitTaskId | PackageTaskId]: ...
    async def get_task_configs(self, disable_verification: bool = False) -> list[TaskConfig]: ...
    async def _get_local_task_configs(self, disable_verification: bool) -> list[TaskConfig]: ...
    async def _get_repo_task_configs(self) -> list[TaskConfig]: ...
    async def _get_registry_task_configs(self) -> list[TaskConfig]: ...
    async def _get_package_task_configs(self) -> list[TaskConfig]: ...

class RetryConfig(BaseModel):
    max_retries: int = ...
    include_exceptions: set[str] | None = ...
    exclude_exceptions: set[str] | None = ...
    wait_multiplier: float = ...
    min_wait_sec: float = ...
    max_wait_sec: float = ...

class SourceJobConfig(BaseModel):
    action: Literal["regrade"]
    type: Literal["local", "hub"]
    job_id: UUID | None = ...
    path: Path | None = ...

def migrate_legacy_job_config(data: Any) -> Any: ...

class JobConfig(BaseModel):
    job_name: str = ...
    jobs_dir: Path = ...
    n_attempts: int = ...
    install_only: bool = ...
    timeout_multiplier: float = ...
    agent_timeout_multiplier: float | None = ...
    verifier_timeout_multiplier: float | None = ...
    agent_setup_timeout_multiplier: float | None = ...
    environment_build_timeout_multiplier: float | None = ...
    debug: bool = ...
    n_concurrent_trials: int = ...
    quiet: bool = ...
    retry: RetryConfig = ...
    environment: EnvironmentConfig = ...
    verifier: VerifierConfig = ...
    metrics: list[MetricConfig] = ...
    agents: list[AgentConfig] = ...
    user_agent: UserAgentConfig | None = ...
    datasets: list[DatasetConfig] = ...
    tasks: list[TaskConfig] = ...
    artifacts: list[str | ArtifactConfig] = ...
    extra_instruction_paths: list[Path] = ...
    extra_instructions: list[str] = ...
    source_jobs: list[SourceJobConfig] = ...
    @property
    def is_regrade(self) -> bool: ...
    def validate_agent_concurrency_limits(self) -> None: ...
    def __eq__(self, other: object) -> bool: ...
