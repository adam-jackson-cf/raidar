from pydantic import BaseModel

LOCK_FILENAME: str
_DIGEST_PREFIX: str
TaskIdType = GitTaskId | LocalTaskId | PackageTaskId

class TaskDownloadResolution(Protocol):
    path: Path
    content_hash: str | None
    resolved_git_commit_id: str | None

def _validate_digest(value: str) -> str: ...
def _prefixed_digest(value: str) -> str: ...

class HarborLockInfo(BaseModel):
    version: str | None = ...
    git_commit_hash: str | None = ...
    is_editable: bool | None = ...

class TaskLock(BaseModel):
    name: str
    version: str | None = ...
    type: Literal["local", "git", "package"]
    digest: str
    source: str | None = ...
    path: Path | None = ...
    git_url: str | None = ...
    git_commit_id: str | None = ...
    @classmethod
    def validate_digest(cls, value: str) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def _equality_key(self) -> tuple[str]: ...

class SourceTrialLock(BaseModel):
    action: Literal["regrade"]
    type: Literal["local", "hub"]
    trial_id: UUID | None = ...
    path: Path | None = ...
    task: TaskLock | None = ...
    def __eq__(self, other: object) -> bool: ...
    def _equality_key(self) -> tuple[str, str, str, str | None]: ...

class ExtraInstructionLock(BaseModel):
    path: Path | None = ...
    digest: str
    @classmethod
    def validate_digest(cls, value: str) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def _equality_key(self) -> tuple[str]: ...

class AgentSkillLock(BaseModel):
    name: str
    source: Path
    digest: str
    git_url: str | None = ...
    git_commit_id: str | None = ...
    @classmethod
    def validate_digest(cls, value: str) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def _equality_key(self) -> tuple[str, str]: ...

class VerifierLock(VerifierConfig):
    environment_mode: VerifierEnvironmentMode | None = ...

class TrialLock(BaseModel):
    schema_version: int = ...
    task: TaskLock
    install_only: bool = ...
    timeout_multiplier: float = ...
    agent_timeout_multiplier: float | None = ...
    verifier_timeout_multiplier: float | None = ...
    agent_setup_timeout_multiplier: float | None = ...
    environment_build_timeout_multiplier: float | None = ...
    extra_instructions: list[ExtraInstructionLock] | None = ...
    agent: AgentConfig
    user_agent: UserAgentConfig | None = ...
    user_persona: ExtraInstructionLock | None = ...
    user_prompt_template: ExtraInstructionLock | None = ...
    bridge_prompt: ExtraInstructionLock | None = ...
    bridge_inputs: dict[str, ExtraInstructionLock] = ...
    skills: list[AgentSkillLock] = ...
    environment: EnvironmentConfig
    extra_docker_compose: list[ExtraDockerComposeLock] | None = ...
    verifier: VerifierLock
    source_trial: SourceTrialLock | None = ...
    def __eq__(self, other: object) -> bool: ...
    def _equality_key(self) -> tuple[Any, ...]: ...

class ExtraDockerComposeLock(BaseModel):
    path: Path
    digest: str
    @classmethod
    def validate_digest(cls, value: str) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def _equality_key(self) -> tuple[str]: ...

class JobLock(BaseModel):
    schema_version: int = ...
    created_at: datetime = ...
    harbor: HarborLockInfo = ...
    n_concurrent_trials: int
    retry: RetryConfig
    trials: list[TrialLock] = ...
    def __eq__(self, other: object) -> bool: ...
    def _equality_key(self) -> tuple[Any, ...]: ...

def _unordered_lock_list_equality_key(locks: Sequence[Any]) -> tuple[Any, ...]: ...
def _lock_list_equality_key(locks: Sequence[Any] | None) -> tuple[Any, ...] | None: ...
def _frozen_value(value: Any, exclude: set[str] | None = None) -> Any: ...
