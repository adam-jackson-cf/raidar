import abc
import logging
from abc import ABC, abstractmethod
from collections.abc import Mapping
from pathlib import Path, PurePosixPath
from typing import Any, ClassVar
from uuid import UUID

from _typeshed import Incomplete
from harbor.agents.capabilities import AgentCapabilities as AgentCapabilities
from harbor.agents.model_connection import (
    ModelConnectionSpec as ModelConnectionSpec,
    ResolvedModelConnection as ResolvedModelConnection,
    resolve_model_connection as resolve_model_connection,
)
from harbor.agents.options import (
    AgentOptions as AgentOptions,
    apply_env_fallbacks as apply_env_fallbacks,
)
from harbor.environments.base import BaseEnvironment as BaseEnvironment
from harbor.models.agent.context import AgentContext as AgentContext
from harbor.models.agent.name import AgentName as AgentName
from harbor.models.bridge import BridgeKind as BridgeKind
from harbor.models.task.config import MCPServerConfig as MCPServerConfig
from harbor.models.trial.paths import EnvironmentPaths as EnvironmentPaths
from harbor.models.trial.result import AgentInfo as AgentInfo, ModelInfo as ModelInfo

class BaseAgent(ABC, metaclass=abc.ABCMeta):
    logs_dir: Path
    environment_logs_dir: PurePosixPath
    model_name: str | None
    logger: logging.Logger
    session_id: str | None = ...
    context_id: UUID | None = ...
    capabilities: ClassVar[AgentCapabilities] = ...
    SUPPORTS_ATIF: ClassVar[bool] = ...
    SUPPORTS_RESUME: ClassVar[bool] = ...
    SUPPORTS_LOAD_NATIVE_TRAJECTORY: ClassVar[bool] = ...
    SUPPORTS_LOAD_ATIF_TRAJECTORY: ClassVar[bool] = ...
    SUPPORTS_HANDOFF: ClassVar[bool] = ...
    SUPPORTS_CONFIG: ClassVar[bool] = ...
    SUPPORTS_WINDOWS: ClassVar[bool] = ...
    SUPPORTED_BRIDGES: ClassVar[frozenset[BridgeKind]] = ...
    MODEL_CONNECTION: ClassVar[ModelConnectionSpec | None] = ...
    _LEGACY_CAPABILITY_FIELDS: ClassVar[dict[str, str]] = ...
    def __init_subclass__(cls, **kwargs: Any) -> None: ...
    options_model: ClassVar[type[AgentOptions] | None] = ...
    mcp_servers: Incomplete
    skills_dir: Incomplete
    load_trajectory: Incomplete
    _extra_env: dict[str, str]
    options: Incomplete
    def __init__(
        self,
        logs_dir: Path,
        model_name: str | None = None,
        logger: logging.Logger | None = None,
        mcp_servers: list[MCPServerConfig] | None = None,
        skills_dir: str | None = None,
        *,
        extra_env: dict[str, str] | None = None,
        load_trajectory: str | Path | None = None,
        environment_logs_dir: PurePosixPath | None = None,
        **kwargs: object,
    ) -> None: ...
    @classmethod
    def parse_options(
        cls, kwargs: dict[str, Any] | None = None, env: Mapping[str, str] | None = None
    ) -> AgentOptions | None: ...
    @classmethod
    def preflight(
        cls, kwargs: dict[str, Any] | None = None, env: Mapping[str, str] | None = None
    ) -> None: ...
    @classmethod
    def options_schema(cls) -> dict[str, Any]: ...
    @property
    def extra_env(self) -> dict[str, str]: ...
    def _env_sources(self) -> tuple[Mapping[str, str], ...]: ...
    def _resolve_env(self, key: str, *alternatives: str) -> tuple[str, str] | None: ...
    def _get_env(self, key: str, *alternatives: str) -> str | None: ...
    def _get_env_prefixed(self, prefix: str) -> dict[str, str]: ...
    @property
    def model_connection(self) -> ResolvedModelConnection: ...
    _parsed_model_provider: Incomplete
    _parsed_model_name: Incomplete
    def _init_model_info(self) -> None: ...
    def to_agent_info(self) -> AgentInfo: ...
    @staticmethod
    @abstractmethod
    def name() -> str: ...
    @abstractmethod
    def version(self) -> str | None: ...
    @classmethod
    def import_path(cls) -> str: ...
    @abstractmethod
    async def setup(self, environment: BaseEnvironment) -> None: ...
    @abstractmethod
    async def run(
        self, instruction: str, environment: BaseEnvironment, context: AgentContext
    ) -> None: ...
    async def resume(
        self, instruction: str, environment: BaseEnvironment, context: AgentContext
    ) -> None: ...
    async def load(
        self, instruction: str, environment: BaseEnvironment, context: AgentContext
    ) -> None: ...
    @classmethod
    def handoff(cls, trial_dir: Path, cwd: Path) -> list[str]: ...
    def populate_context_post_run(self, context: AgentContext) -> None: ...
