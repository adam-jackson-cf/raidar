class ClaudeCodeOptions(InstalledAgentOptions):
    max_turns: Annotated[int | None, None] = ...
    reasoning_effort: Annotated[Literal["low", "medium", "high", "xhigh", "max"] | None, None] = ...
    thinking_display: Annotated[Literal["summarized", "omitted"] | None, None] = ...
    max_budget_usd: Annotated[str | None, None] = ...
    fallback_model: Annotated[str | None, None] = ...
    append_system_prompt: Annotated[str | None, None] = ...
    allowed_tools: Annotated[str | None, None] = ...
    disallowed_tools: Annotated[str | None, None] = ...
    permission_mode: Annotated[
        Literal["default", "acceptEdits", "plan", "auto", "dontAsk", "bypassPermissions"] | None,
        None,
    ] = ...
    max_thinking_tokens: Annotated[int | None, None] = ...
    memory_dir: str | None = ...

