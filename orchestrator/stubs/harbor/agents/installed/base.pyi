from collections.abc import Mapping
from dataclasses import dataclass
from pathlib import Path
from typing import Any, ClassVar, Literal, Self, override

from _typeshed import Incomplete
from harbor.agents.base import BaseAgent as BaseAgent
from harbor.agents.options import (
    InstalledAgentOptions as InstalledAgentOptions,
    cli_annotation as cli_annotation,
    compile_cli_from_options as compile_cli_from_options,
    compile_env_from_options as compile_env_from_options,
    sensitive_option_values as sensitive_option_values,
)
from harbor.environments.base import BaseEnvironment as BaseEnvironment
from harbor.models.agent.context import AgentContext as AgentContext
from harbor.models.trajectories import Trajectory as Trajectory
from harbor.utils.env import (
    is_sensitive_env_key as is_sensitive_env_key,
    parse_bool_env_value as parse_bool_env_value,
    redact_sensitive_value as redact_sensitive_value,
)
from harbor.utils.templating import render_prompt_template as render_prompt_template

class NonZeroAgentExitCodeError(RuntimeError): ...
class ApiError(NonZeroAgentExitCodeError): ...
class ApiRateLimitError(ApiError): ...
class ApiUsageLimitError(ApiError): ...
class ApiInternalServerError(ApiError): ...
class ApiOverloadedError(ApiError): ...
class ApiConnectionClosedError(ApiError): ...
class ApiResponseStalledError(ApiError): ...
class OutputTokenExceededError(ApiError): ...
class ContextWindowExceededError(ApiError): ...
class UnknownApiError(ApiError): ...
class ApiProviderResourceNotFoundError(ApiError): ...
class AgentSafetyRefusalError(ApiError): ...
class AgentAuthenticationError(NonZeroAgentExitCodeError): ...
class ModelNotFoundError(NonZeroAgentExitCodeError): ...
class NetworkConnectionError(NonZeroAgentExitCodeError): ...

_F = Any

def with_prompt_template(fn: _F) -> _F: ...
@dataclass
class CliFlag:
    kwarg: str
    cli: str
    type: Literal["str", "int", "bool", "enum"] = ...
    choices: list[str] | None = ...
    default: Any = ...
    env_fallback: str | None = ...
    format: str | None = ...

@dataclass
class EnvVar:
    kwarg: str
    env: str
    type: Literal["str", "int", "bool", "enum"] = ...
    choices: list[str] | None = ...
    default: Any = ...
    env_fallback: str | None = ...
    bool_true: str = ...
    bool_false: str = ...

@dataclass
class ErrorPattern:
    pattern: str
    exception: type[NonZeroAgentExitCodeError]

@dataclass(frozen=True)
class PackageSpec:
    commands: tuple[str, ...]
    packages: dict[str, tuple[str, ...]]
    always_install: bool = ...
    @classmethod
    def standard(cls, name: str) -> Self: ...

class BaseInstalledAgent(BaseAgent, ABC, metaclass=abc.ABCMeta):
    CLI_FLAGS: ClassVar[list[CliFlag]] = ...
    ENV_VARS: ClassVar[list[EnvVar]] = ...
    options_model: ClassVar[type[InstalledAgentOptions] | None] = ...
    SYSTEM_PACKAGES: ClassVar[dict[str, PackageSpec]] = ...
    ERROR_PATTERNS: ClassVar[list[ErrorPattern]] = ...
    def __init_subclass__(cls, **kwargs: Any) -> None: ...
    _flag_kwargs: dict[str, Any]
    _resolved_env_vars: dict[str, str]
    _config: Path | dict[str, Any] | None
    _resolved_flags: Incomplete
    _compiled_error_patterns: Incomplete
    _prompt_template_path: Incomplete
    _version: Incomplete
    _atif_load_trajectory: Trajectory | None
    def __init__(
        self,
        logs_dir: Path,
        prompt_template_path: Path | str | None = None,
        version: str | None = None,
        extra_env: dict[str, str] | None = None,
        *,
        config: Path | str | dict[str, Any] | None = None,
        **kwargs: object,
    ) -> None: ...
    @override
    def _env_sources(self) -> tuple[Mapping[str, str], ...]: ...
    @property
    def config_source(self) -> Path | dict[str, Any] | None: ...
    def _env_from_options(self) -> dict[str, str]: ...
    def _flags_from_options(self) -> dict[str, Any]: ...
    async def _get_system_package_manager(self, environment: BaseEnvironment) -> str | None: ...
    async def ensure_system_dependencies(
        self, environment: BaseEnvironment, dependencies: tuple[str, ...]
    ) -> None: ...
    def _resolve_raw_value(self, descriptor: CliFlag | EnvVar) -> Any: ...
    def _resolve_flag_values(self) -> dict[str, Any]: ...
    def compile_cli_flags(self) -> str: ...
    def build_cli_flags(self) -> str: ...
    def _resolve_env_values(self) -> dict[str, str]: ...
    def compile_env_vars(self) -> dict[str, str]: ...
    def resolve_env_vars(self) -> dict[str, str]: ...
    @override
    def version(self) -> str | None: ...
    def get_version_command(self) -> str | None: ...
    def parse_version(self, stdout: str) -> str: ...
    def _truncate_output(self, text: str | None, max_len: int = 1000) -> str: ...
    def _redact_command(self, command: str) -> str: ...
    def _classify_exec_error(self, command: str, result: Any) -> NonZeroAgentExitCodeError: ...
    async def _exec(
        self,
        environment: BaseEnvironment,
        command: str,
        user: str | int | None = None,
        env: dict[str, str] | None = None,
        cwd: str | None = None,
        timeout_sec: int | None = None,
    ) -> Any: ...
    async def exec_as_root(
        self,
        environment: BaseEnvironment,
        command: str,
        env: dict[str, str] | None = None,
        cwd: str | None = None,
        timeout_sec: int | None = None,
    ) -> Any: ...
    async def exec_as_agent(
        self,
        environment: BaseEnvironment,
        command: str,
        env: dict[str, str] | None = None,
        cwd: str | None = None,
        timeout_sec: int | None = None,
    ) -> Any: ...
    async def _upload_config_text(
        self, environment: BaseEnvironment, *, content: str, remote_path: str, filename: str
    ) -> None: ...
    def render_instruction(self, instruction: str) -> str: ...
    @abstractmethod
    async def install(self, environment: BaseEnvironment) -> None: ...
    @override
    async def setup(self, environment: BaseEnvironment) -> None: ...
    _resume: bool = ...
    _load: bool = ...
    def _validate_load_trajectory(self) -> Trajectory | None: ...
    def _validate_native_load_trajectory(self, path: Path) -> None: ...
    @staticmethod
    def _atif_session_id(trajectory: Trajectory) -> str: ...
    @override
    async def resume(
        self, instruction: str, environment: BaseEnvironment, context: AgentContext
    ) -> None: ...
    @override
    async def load(
        self, instruction: str, environment: BaseEnvironment, context: AgentContext
    ) -> None: ...
    async def _seed_load_trajectory(self, environment: BaseEnvironment) -> str: ...
    def atif_to_native_trajectory(
        self, trajectory: Trajectory, session_id: str
    ) -> tuple[str, str]: ...
    async def _upload_load_trajectory(self, environment: BaseEnvironment, source: Path) -> None: ...
    async def _upload_agent_owned_file(
        self, environment: BaseEnvironment, source: Path, target: str
    ) -> None: ...
