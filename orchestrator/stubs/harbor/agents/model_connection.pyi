from collections.abc import Callable as Callable, Mapping
from dataclasses import dataclass, field

from _typeshed import Incomplete

@dataclass(frozen=True)
class ProviderAccess:
    api_key_envs: tuple[str, ...]
    base_url: str | None = ...
    base_url_envs: tuple[str, ...] = ...
    extra_envs: tuple[str, ...] = ...

PROVIDERS: dict[str, ProviderAccess]
_PROVIDER_ALIASES: Incomplete

@dataclass(frozen=True)
class ModelConnectionSpec:
    default_provider: str | None = ...
    api_key_envs: tuple[str, ...] = ...
    base_url_envs: tuple[str, ...] = ...
    passthrough: bool = ...

@dataclass(frozen=True)
class ResolvedModelConnection:
    provider: str | None = ...
    api_key: str | None = field(default=None, repr=False)
    base_url: str | None = ...
    configured_base_url: str | None = ...
    env: Mapping[str, str] = field(default_factory=dict, repr=False)

def resolve_model_connection(
    model_name: str | None,
    spec: ModelConnectionSpec,
    resolve_env: Callable[..., tuple[str, str] | None],
) -> ResolvedModelConnection: ...
def with_canonical_provider_envs(
    connection: ResolvedModelConnection,
) -> ResolvedModelConnection: ...
def without_provider_api_key_envs(
    connection: ResolvedModelConnection,
) -> ResolvedModelConnection: ...
def without_inferred_endpoint(connection: ResolvedModelConnection) -> ResolvedModelConnection: ...
def without_inferred_base_url(connection: ResolvedModelConnection) -> ResolvedModelConnection: ...
