from pathlib import Path
from typing import override

from harbor.environments.base import HealthcheckError as HealthcheckError
from harbor.models.task.config import StepConfig as StepConfig
from harbor.models.task.task import Task as Task
from harbor.models.task.verifier_mode import (
    VerifierEnvironmentMode as VerifierEnvironmentMode,
    resolve_step_verifier_mode as resolve_step_verifier_mode,
)
from harbor.models.trial.config import TrialConfig as TrialConfig
from harbor.models.trial.result import ExceptionInfo as ExceptionInfo, StepResult as StepResult
from harbor.tasks.client import TaskDownloadResult as TaskDownloadResult
from harbor.trial.trial import Trial as Trial
from harbor.utils.path_safety import (
    directory_move_plan as directory_move_plan,
    validate_directory_copy as validate_directory_copy,
    validate_output_path as validate_output_path,
)

class MultiStepTrial(Trial):
    def __init__(
        self,
        config: TrialConfig,
        *,
        _task: Task | None = None,
        _task_download_result: TaskDownloadResult,
    ) -> None: ...
    def _validate_resume_support(self) -> None: ...
    @override
    async def _run(self) -> None: ...
    @override
    async def _recover_outputs(self) -> None: ...
    async def _run_step(
        self, step: StepConfig, step_result: StepResult, *, index: int, total: int
    ) -> None: ...
    _are_agent_logs_downloaded: bool
    async def _prepare_step(
        self, step: StepConfig, step_result: StepResult, *, resume: bool
    ) -> None: ...
    async def _run_step_agent(
        self, step: StepConfig, step_result: StepResult, *, resume: bool, load: bool = False
    ) -> None: ...
    def _should_stop_after_step(self, step: StepConfig, step_result: StepResult) -> bool: ...
    @staticmethod
    def _min_reward_failure(
        rewards: dict[str, float | int] | None, min_reward: float | dict[str, float]
    ) -> str | None: ...
    def _create_step_dirs(self, step: StepConfig) -> None: ...
    async def _collect_step_artifacts(
        self, step: StepConfig, *, stop_main_before_sidecars: bool = False
    ) -> Path: ...
    async def _reset_agent_logs_for_step(self, *, resume: bool) -> None: ...
    async def _upload_step_workdir(self, step: StepConfig) -> str: ...
    async def _run_step_setup(
        self, step: StepConfig, step_result: StepResult, workdir: str
    ) -> None: ...
    async def _run_step_healthcheck(self, step: StepConfig, step_result: StepResult) -> None: ...
    def _archive_step_outputs(self, step: StepConfig, *, preserve_agent: bool = False) -> None: ...
    def _copy_agent_dir_to_step(self, step: StepConfig) -> None: ...
    def _move_agent_dir_to_step(self, step: StepConfig) -> None: ...
    def _step_resumes(self, index: int) -> bool: ...
    def _step_loads(self, index: int) -> bool: ...
    def _next_step_resumes(self, *, index: int, total: int) -> bool: ...
    def _step_agent_timeout_sec(self, step: StepConfig) -> float | None: ...
    def _step_agent_user(self, step: StepConfig) -> str | int | None: ...
