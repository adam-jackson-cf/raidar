import abc
from abc import ABC, abstractmethod
from pathlib import Path

from _typeshed import Incomplete
from harbor.agents.base import BaseAgent as BaseAgent
from harbor.environments.base import BaseEnvironment as BaseEnvironment
from harbor.models.agent.context import AgentContext as AgentContext
from harbor.models.bridge import BridgeConfig as BridgeConfig, BridgeKind as BridgeKind

class BaseBridge(ABC, metaclass=abc.ABCMeta):
    trajectory_filename: str = ...
    _config: Incomplete
    _agent: Incomplete
    def __init__(self, config: BridgeConfig, agent: BaseAgent) -> None: ...
    @classmethod
    def input_files(cls, config: BridgeConfig) -> dict[str, Path]: ...
    @classmethod
    async def create(cls, config: BridgeConfig, agent: BaseAgent) -> BaseBridge: ...
    @abstractmethod
    async def setup(self, environment: BaseEnvironment) -> None: ...
    @abstractmethod
    def prompt(self) -> str: ...
    @abstractmethod
    def env(self) -> dict[str, str]: ...
    @abstractmethod
    async def export_trajectory(self, environment: BaseEnvironment, output_path: Path) -> None: ...
    def enrich_context(self, context: AgentContext, trajectory_path: Path) -> None: ...
    @abstractmethod
    async def teardown(self, environment: BaseEnvironment) -> None: ...

def bridge_class_for_kind(kind: BridgeKind) -> type[BaseBridge]: ...
def bridge_input_files(config: BridgeConfig) -> dict[str, Path]: ...
def register_bridge(kind: BridgeKind, bridge_class: type[BaseBridge]) -> None: ...

_BRIDGE_CLASSES: dict[BridgeKind, type[BaseBridge]]
