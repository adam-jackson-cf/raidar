from collections.abc import Callable
from dataclasses import dataclass

from _typeshed import Incomplete

@dataclass(frozen=True)
class ContainerRuntime:
    engine: tuple[str, ...]
    compose: tuple[str, ...]
    supports_compose_wait: bool = ...
    supports_compose_cp: bool = ...
    supports_compose_project_directory: bool = ...
    def engine_cmd(self, *args: str) -> list[str]: ...
    def compose_cmd(self, *args: str) -> list[str]: ...
    @property
    def up_args(self) -> list[str]: ...

DOCKER_RUNTIME: Incomplete
_Which = Callable[[str], str | None]
_Run: Incomplete

def _run_help(argv: list[str], *, run: _Run) -> bytes: ...
def _help_mentions(argv: list[str], flag: str, *, run: _Run) -> bool: ...
def resolve_podman_runtime(*, which: _Which = ..., run: _Run = ...) -> ContainerRuntime: ...
