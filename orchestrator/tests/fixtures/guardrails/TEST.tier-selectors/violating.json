{
  "rule": "TEST.tier-selectors",
  "expect": "fail",
  "check": {
    "subcommand": "collection-check",
    "argv": [
      "--tier",
      "t1=lists/t1.txt",
      "--tier",
      "t2=lists/t2.txt",
      "--tier",
      "t3=lists/t3.txt"
    ]
  },
  "files": {
    "orchestrator/tests/test_cart_totals.py": "def test_total_of_two_items_is_their_sum() -> None:\n    assert 2 + 3 == 5\n",
    "orchestrator/tests/test_cart_checkout_slow.py": "def test_total_of_two_items_is_their_sum() -> None:\n    assert 2 + 3 == 5\n",
    "orchestrator/tests/test_cart_load_perf.py": "def test_total_of_two_items_is_their_sum() -> None:\n    assert 2 + 3 == 5\n",
    "lists/t1.txt": "orchestrator/tests/test_cart_totals.py::test_total_of_two_items_is_their_sum\n",
    "lists/t2.txt": "orchestrator/tests/test_cart_totals.py::test_total_of_two_items_is_their_sum\n",
    "lists/t3.txt": "orchestrator/tests/test_cart_load_perf.py::test_total_of_two_items_is_their_sum\n"
  },
  "profile": {
    "tiers": {
      "t1": {
        "selector": "-m 'not slow'",
        "location": "orchestrator/tests",
        "command": "make test-fast"
      },
      "t2": {
        "selector": "-m slow",
        "location": "orchestrator/tests",
        "command": "make test-slow"
      },
      "t3": {
        "selector": "-m perf",
        "location": "orchestrator/tests",
        "command": "make perf-gate"
      }
    }
  }
}
