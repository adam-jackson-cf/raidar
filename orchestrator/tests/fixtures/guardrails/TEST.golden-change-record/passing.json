{
  "rule": "TEST.golden-change-record",
  "expect": "pass",
  "check": {
    "command": [
      "sh",
      "-c",
      "out=$({python} -m omp_guardrails.cli diff-check --base HEAD --head \"$(git write-tree)\" 2>&1); status=$?; printf \"%s\\n\" \"$out\"; [ $status -ge 2 ] && exit 2; printf \"%s\\n\" \"$out\" | grep -q \": TEST.golden-change-record: \" && exit 1; exit 0"
    ],
    "timeout_s": 60
  },
  "base": {
    "orchestrator/tests/fixtures/code_quality/fork_goldens.json": "{\"score\": 1}\n",
    "docs/golden-changes.md": "# Golden changes\n"
  },
  "files": {
    "orchestrator/tests/fixtures/code_quality/fork_goldens.json": "{\"score\": 2}\n",
    "docs/golden-changes.md": "# Golden changes\n\n- orchestrator/tests/fixtures/code_quality/fork_goldens.json: fork scorer fix\n"
  },
  "profile": {
    "guardrails": {
      "golden_record": {
        "globs": [
          "orchestrator/tests/fixtures/code_quality/fork_goldens.json"
        ],
        "change_record": "docs/golden-changes.md"
      }
    }
  }
}
