[importlinter]
root_package = raidar

[importlinter:contract:schema-boundary]
name = Review schemas stay independent of every other raidar layer
type = forbidden
source_modules =
    raidar.schemas
forbidden_modules =
    raidar.agents
    raidar.analysis
    raidar.commands
    raidar.components
    raidar.execution
    raidar.jev
    raidar.review_projection
    raidar.review_quality
    raidar.scorers
    raidar.spec
    raidar.cli

[importlinter:contract:scorers-boundary]
name = Scorers stay independent of execution, agents, commands, and CLI layers
type = forbidden
source_modules =
    raidar.scorers
forbidden_modules =
    raidar.execution
    raidar.agents
    raidar.commands
    raidar.cli

[importlinter:contract:spec-boundary]
name = Experiment spec stays independent of execution, commands, and CLI layers
type = forbidden
source_modules =
    raidar.spec
forbidden_modules =
    raidar.execution
    raidar.commands
    raidar.cli

[importlinter:contract:packs-boundary]
name = Runtime packs stay independent of execution, agents, commands, and CLI layers
type = forbidden
source_modules =
    raidar.packs
forbidden_modules =
    raidar.execution
    raidar.agents
    raidar.commands
    raidar.cli

[importlinter:contract:oracle-boundary]
name = Oracle plugin stays independent of execution, agents, commands, and CLI layers
type = forbidden
source_modules =
    raidar.oracle
forbidden_modules =
    raidar.execution
    raidar.agents
    raidar.commands
    raidar.cli

[importlinter:contract:problems-boundary]
name = Problems stay independent of execution, agents, commands, and CLI layers
type = forbidden
source_modules =
    raidar.problems
forbidden_modules =
    raidar.execution
    raidar.agents
    raidar.commands
    raidar.cli

[importlinter:contract:components-boundary]
name = Components stay independent of execution, commands, and CLI layers
type = forbidden
source_modules =
    raidar.components
forbidden_modules =
    raidar.execution
    raidar.commands
    raidar.cli

[importlinter:contract:jev-boundary]
name = Jev stays independent of execution, agents, commands, and CLI layers
type = forbidden
source_modules =
    raidar.jev
forbidden_modules =
    raidar.execution
    raidar.agents
    raidar.commands
    raidar.cli

[importlinter:contract:execution-boundary]
name = Execution stays independent of the commands and CLI layers
type = forbidden
source_modules =
    raidar.execution
forbidden_modules =
    raidar.commands
    raidar.cli

[importlinter:contract:analysis-boundary]
name = Analysis stays independent of the commands and CLI layers
type = forbidden
source_modules =
    raidar.analysis
forbidden_modules =
    raidar.commands
    raidar.cli

[importlinter:contract:review-projection-boundary]
name = Review projection stays independent of the commands and CLI layers
type = forbidden
source_modules =
    raidar.review_projection
forbidden_modules =
    raidar.commands
    raidar.cli

[importlinter:contract:review-quality-boundary]
name = Quality projection stays independent of the commands and CLI layers
type = forbidden
source_modules =
    raidar.review_quality
forbidden_modules =
    raidar.commands
    raidar.cli

[importlinter:contract:scenario-epoch-isolation]
name = Scenario-epoch history (read-only) depends on nothing but the frozen review schema
type = forbidden
source_modules =
    raidar.review_projection.scenario_epoch
forbidden_modules =
    raidar.agents
    raidar.analysis
    raidar.cli
    raidar.codex_auth
    raidar.commands
    raidar.components
    raidar.execution
    raidar.harness
    raidar.jev
    raidar.oracle
    raidar.packs
    raidar.problems
    raidar.review_quality
    raidar.scorers
    raidar.spec
    raidar.review_projection.assessments
    raidar.review_projection.atif
    raidar.review_projection.comparability
    raidar.review_projection.conditions
    raidar.review_projection.experiment_epoch
    raidar.review_projection.experiments
    raidar.review_projection.fixture
    raidar.review_projection.fixture_assessments
    raidar.review_projection.fixture_trials
    raidar.review_projection.gates
    raidar.review_projection.headline
    raidar.review_projection.merge
    raidar.review_projection.notes
    raidar.review_projection.scoring
    raidar.review_projection.sources
    raidar.review_projection.spans
    raidar.review_projection.trials

[importlinter:contract:scenario-epoch-importers]
name = Only the projection merge and the experiment fixture import scenario-epoch history
type = forbidden
source_modules =
    raidar.agents
    raidar.analysis
    raidar.cli
    raidar.codex_auth
    raidar.commands
    raidar.components
    raidar.execution
    raidar.harness
    raidar.jev
    raidar.oracle
    raidar.packs
    raidar.problems
    raidar.review_quality
    raidar.schemas
    raidar.scorers
    raidar.spec
    raidar.review_projection.assessments
    raidar.review_projection.atif
    raidar.review_projection.comparability
    raidar.review_projection.conditions
    raidar.review_projection.experiment_epoch
    raidar.review_projection.experiments
    raidar.review_projection.fixture_assessments
    raidar.review_projection.fixture_trials
    raidar.review_projection.gates
    raidar.review_projection.headline
    raidar.review_projection.notes
    raidar.review_projection.scoring
    raidar.review_projection.sources
    raidar.review_projection.spans
    raidar.review_projection.trials
forbidden_modules =
    raidar.review_projection.scenario_epoch
allow_indirect_imports = True
