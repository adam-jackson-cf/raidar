[importlinter]
root_package = raidar

[importlinter:contract:core-boundary]
name = Core value types stay independent of every other raidar layer
type = forbidden
source_modules =
    raidar.core
forbidden_modules =
    raidar.agents
    raidar.analysis
    raidar.cli
    raidar.components
    raidar.execution
    raidar.jev
    raidar.review
    raidar.scorers
    raidar.spec

[importlinter:contract:scorers-boundary]
name = Scorers stay independent of execution, agents, and the CLI layer
type = forbidden
source_modules =
    raidar.scorers
forbidden_modules =
    raidar.execution
    raidar.agents
    raidar.cli

[importlinter:contract:spec-boundary]
name = Experiment spec stays independent of execution and the CLI layer
type = forbidden
source_modules =
    raidar.spec
forbidden_modules =
    raidar.execution
    raidar.cli

[importlinter:contract:packs-boundary]
name = Runtime packs stay independent of execution, agents, and the CLI layer
type = forbidden
source_modules =
    raidar.packs
forbidden_modules =
    raidar.execution
    raidar.agents
    raidar.cli

[importlinter:contract:verifier-boundary]
name = Verifier stays independent of execution, agents, and the CLI layer
type = forbidden
source_modules =
    raidar.verifier
forbidden_modules =
    raidar.execution
    raidar.agents
    raidar.cli

[importlinter:contract:problems-boundary]
name = Problems stay independent of execution, agents, and the CLI layer
type = forbidden
source_modules =
    raidar.problems
forbidden_modules =
    raidar.execution
    raidar.agents
    raidar.cli

[importlinter:contract:components-boundary]
name = Components stay independent of execution and the CLI layer
type = forbidden
source_modules =
    raidar.components
forbidden_modules =
    raidar.execution
    raidar.cli

[importlinter:contract:jev-boundary]
name = Jev stays independent of execution, agents, and the CLI layer
type = forbidden
source_modules =
    raidar.jev
forbidden_modules =
    raidar.execution
    raidar.agents
    raidar.cli

[importlinter:contract:execution-boundary]
name = Execution stays independent of the CLI layer
type = forbidden
source_modules =
    raidar.execution
forbidden_modules =
    raidar.cli

[importlinter:contract:analysis-boundary]
name = Analysis stays independent of the CLI layer
type = forbidden
source_modules =
    raidar.analysis
forbidden_modules =
    raidar.cli

[importlinter:contract:review-boundary]
name = Review projection and quality stay independent of the CLI layer
type = forbidden
source_modules =
    raidar.review
forbidden_modules =
    raidar.cli

[importlinter:contract:ledger-boundary]
name = Ledger stays independent of every other raidar layer
type = forbidden
source_modules =
    raidar.ledger
forbidden_modules =
    raidar.agents
    raidar.analysis
    raidar.cli
    raidar.components
    raidar.execution
    raidar.scorers
    raidar.spec

[importlinter:contract:deterministic-process-checks]
name = process-compliance decides only deterministically: no Jev import, direct or indirect
type = forbidden
source_modules =
    raidar.scorers.process_checks
forbidden_modules =
    raidar.jev
