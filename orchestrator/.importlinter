[importlinter]
root_package = raidar

[importlinter:contract:cli-boundary]
name = Nothing imports the CLI layer
type = forbidden
source_modules =
    raidar.contract
    raidar.design
    raidar.subject
    raidar.engine
    raidar.grading
    raidar.scoring
    raidar.evaluation
forbidden_modules =
    raidar.cli

[importlinter:contract:contracts-boundary]
name = Shared contracts stay independent of every stage
type = forbidden
source_modules =
    raidar.contract
forbidden_modules =
    raidar.cli
    raidar.design
    raidar.subject
    raidar.engine
    raidar.grading
    raidar.scoring
    raidar.evaluation

[importlinter:contract:design-experiments-boundary]
name = Experiment design stays independent of the engine and the CLI layer
type = forbidden
source_modules =
    raidar.design.experiment
forbidden_modules =
    raidar.engine
    raidar.cli

[importlinter:contract:design-problems-boundary]
name = Problems stay independent of the engine, agents, and the CLI layer
type = forbidden
source_modules =
    raidar.design.problem
forbidden_modules =
    raidar.engine
    raidar.subject.agent
    raidar.cli

[importlinter:contract:subjects-environments-boundary]
name = Runtime environments (packs) stay independent of the engine, agents, and the CLI layer
type = forbidden
source_modules =
    raidar.subject.environment
forbidden_modules =
    raidar.engine
    raidar.subject.agent
    raidar.cli

[importlinter:contract:subjects-treatments-boundary]
name = Treatments (components) stay independent of the engine and the CLI layer
type = forbidden
source_modules =
    raidar.subject.treatment
forbidden_modules =
    raidar.engine
    raidar.cli

[importlinter:contract:engine-boundary]
name = The engine stays independent of the CLI layer
type = forbidden
source_modules =
    raidar.engine
forbidden_modules =
    raidar.cli

[importlinter:contract:grading-boundary]
name = Grading stays independent of the engine, subjects, and the CLI layer
type = forbidden
source_modules =
    raidar.grading
forbidden_modules =
    raidar.engine
    raidar.subject
    raidar.cli

[importlinter:contract:scoring-boundary]
name = Scoring (framework, scorers and the judge) stays independent of the engine, agents, treatments and the CLI layer
type = forbidden
source_modules =
    raidar.scoring
forbidden_modules =
    raidar.engine
    raidar.subject.agent
    raidar.subject.treatment
    raidar.cli

[importlinter:contract:deterministic-process-checks]
name = process-compliance decides only deterministically: no Jev import, direct or indirect
type = forbidden
source_modules =
    raidar.scoring.process_checks
forbidden_modules =
    raidar.scoring.judge

[importlinter:contract:evaluation-boundary]
name = Evaluation (analysis, review views, ledger) stays independent of the CLI layer
type = forbidden
source_modules =
    raidar.evaluation
forbidden_modules =
    raidar.cli

[importlinter:contract:ledger-boundary]
name = Ledger stays independent of every other raidar layer
type = forbidden
source_modules =
    raidar.evaluation.ledger
forbidden_modules =
    raidar.cli
    raidar.design
    raidar.subject
    raidar.engine
    raidar.scoring
    raidar.evaluation.analysis
