[importlinter]
root_package = raidar

[importlinter:contract:runtime-boundary]
name = Runtime modules do not import application or CLI layers
type = forbidden
source_modules =
    raidar.runtime
forbidden_modules =
    raidar.application
    raidar.cli

[importlinter:contract:application-boundary]
name = Application modules do not import the CLI layer
type = forbidden
source_modules =
    raidar.application
forbidden_modules =
    raidar.cli

[importlinter:contract:schema-boundary]
name = Schemas stay independent of runtime, application, agents, and CLI layers
type = forbidden
source_modules =
    raidar.schemas
forbidden_modules =
    raidar.runtime
    raidar.application
    raidar.agents
    raidar.cli

[importlinter:contract:scorers-boundary]
name = Scorers stay independent of runtime, application, agents, and CLI layers
type = forbidden
source_modules =
    raidar.scorers
forbidden_modules =
    raidar.runtime
    raidar.application
    raidar.agents
    raidar.cli

[importlinter:contract:spec-boundary]
name = Experiment spec stays independent of runtime, application, commands, and CLI layers
type = forbidden
source_modules =
    raidar.spec
forbidden_modules =
    raidar.runtime
    raidar.application
    raidar.commands
    raidar.cli

[importlinter:contract:packs-boundary]
name = Runtime packs stay independent of runtime, application, agents, and CLI layers
type = forbidden
source_modules =
    raidar.packs
forbidden_modules =
    raidar.runtime
    raidar.application
    raidar.agents
    raidar.commands
    raidar.cli

[importlinter:contract:oracle-boundary]
name = Oracle plugin stays independent of runtime, application, agents, and CLI layers
type = forbidden
source_modules =
    raidar.oracle
forbidden_modules =
    raidar.runtime
    raidar.application
    raidar.agents
    raidar.commands
    raidar.cli
