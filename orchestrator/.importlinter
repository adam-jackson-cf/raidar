[importlinter]
root_package = raidar

[importlinter:contract:schema-boundary]
name = Review schemas stay independent of every other raidar layer
type = forbidden
source_modules =
    raidar.schemas
forbidden_modules =
    raidar.agents
    raidar.analysis
    raidar.commands
    raidar.components
    raidar.execution
    raidar.jev
    raidar.review_projection
    raidar.review_quality
    raidar.scorers
    raidar.spec
    raidar.cli

[importlinter:contract:scorers-boundary]
name = Scorers stay independent of execution, agents, commands, and CLI layers
type = forbidden
source_modules =
    raidar.scorers
forbidden_modules =
    raidar.execution
    raidar.agents
    raidar.commands
    raidar.cli

[importlinter:contract:spec-boundary]
name = Experiment spec stays independent of execution, commands, and CLI layers
type = forbidden
source_modules =
    raidar.spec
forbidden_modules =
    raidar.execution
    raidar.commands
    raidar.cli

