# Provider credentials
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Codex auth policy: auto prefers file-backed ChatGPT auth.json, then OPENAI_API_KEY.
CODEX_AUTH_MODE=auto

# Optional CLI binary overrides (otherwise resolved from PATH)
CODEX_CLI_PATH=
CLAUDE_CODE_CLI_PATH=
GEMINI_CLI_PATH=

# Advanced and less-common environment variables are documented in:
# docs/references/env-var-lexicon.md
