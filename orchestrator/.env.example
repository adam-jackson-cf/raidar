# Provider credentials
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_CODE_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
GEMINI_API_KEY=
GOOGLE_API_KEY=
COPILOT_API_KEY=
CURSOR_API_KEY=
PI_API_TOKEN=

# Optional CLI binary overrides (otherwise resolved from PATH)
CODEX_CLI_PATH=
CLAUDE_CODE_CLI_PATH=
GEMINI_CLI_PATH=
COPILOT_CLI_PATH=
CURSOR_CLI_PATH=
PI_CLI_PATH=

# Optional smoke-mode flags used by scripts/checks/run-agent-smoke.sh --fast
HARBOR_SMOKE_FAST=
HARBOR_SMOKE_FAST_REUSE_IMAGE=
HARBOR_SMOKE_FAST_IMAGE_PREFIX=

# Optional Gemini/Vertex AI passthrough for fast Harbor harnesses
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_USE_VERTEXAI=

# Optional evaluation tuning overrides. See docs/references/env-var-lexicon.md.
# Examples:
# EVAL_TIMEOUTS__BUILD=300
# EVAL_LLM_JUDGE__MODEL=anthropic/claude-sonnet-4-20250514
