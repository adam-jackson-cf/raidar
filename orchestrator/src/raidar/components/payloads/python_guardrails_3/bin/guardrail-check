#!/bin/sh
# python-guardrails@3 gate entrypoint. Installed root-owned at
# /opt/raidar-tools/python-guardrails/bin/guardrail-check and linked to
# /usr/local/bin/guardrail-check. Exit 0 pass, 1 refused, 126 gate error.
set -u
SELF="$(readlink -f -- "$0" 2>/dev/null || python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$0")"
GUARDRAILS_HOME="${GUARDRAILS_HOME:-$(CDPATH= cd -- "$(dirname -- "$SELF")/.." && pwd -P)}"
export GUARDRAILS_HOME
PY="$GUARDRAILS_HOME/venv/bin/python"
if [ ! -x "$PY" ]; then
  echo "guardrail-check: ERROR, the gate could not run: interpreter missing at $PY"
  exit 126
fi
# An import failure or crash is a gate error (126), never a refusal (1).
PYTHONPATH="$GUARDRAILS_HOME/lib" exec "$PY" -I -B -c '
import sys
sys.path.insert(0, sys.argv.pop(1))
try:
    from guardrails.gate import main
    code = main(sys.argv[1:])
except SystemExit:
    raise
except BaseException as exc:
    print(f"guardrail-check: ERROR, the gate could not run: {type(exc).__name__}: {exc}")
    code = 126
raise SystemExit(code)
' "$GUARDRAILS_HOME/lib" "$@"
